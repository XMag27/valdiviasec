---
import HeaderLink from './HeaderLink.astro';
import Footer from './Footer.astro';
import { getCollection } from 'astro:content';

interface Props {
	title?: string;
}

const { title } = Astro.props;
const allPosts = await getCollection('blog');

// All categories (defined explicitly so they show even with 0 posts)
const allCategories = [
	'writeup',
	'certificaciones',
	'general',
	'red-team',
	'forense',
	'malware',
	'investigacion',
	'papers',
];

const categoryLabels: Record<string, string> = {
	writeup: 'Writeups',
	certificaciones: 'Certificaciones',
	general: 'General',
	'red-team': 'Red Team',
	forense: 'Forense',
	malware: 'Malware',
	investigacion: 'Investigación',
	papers: 'Papers / Conferencias',
};

const categoryIcons: Record<string, string> = {
	writeup: '<path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>',
	certificaciones: '<path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>',
	general: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
	forense: '<path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>',
	malware: '<path d="M12 14l9-5-9-5-9 5 9 5zm0 7l9-5-9-5-9 5 9 5z"/>',
	investigacion: '<path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.573-1.066z"/><circle cx="12" cy="12" r="3"/>',
	papers: '<path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>',
};

// Recent posts for sidebar
const recentPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<div class="layout">
	<aside class="sidebar" id="sidebar">
		<div class="sidebar-inner">
			<div class="sidebar-brand">
				<a href="/" class="logo">
					<img src="/isotipo.svg" alt="ValdiviaSec" width="32" height="32" />
					<div class="logo-text">
						<span class="logo-name">VALDIVIA</span>
						<span class="logo-sub">SEC</span>
					</div>
				</a>
			</div>

			<nav class="sidebar-nav">
				<HeaderLink href="/">Inicio</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">Nosotros</HeaderLink>
			</nav>

			<div class="sidebar-section">
				<h4 class="sidebar-heading">Categorías</h4>
				<div class="sidebar-tags">
					{allCategories.map(cat => (
						<a href={`/blog?cat=${cat}`} class="sidebar-tag">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={categoryIcons[cat]} />
							{categoryLabels[cat]}
						</a>
					))}
				</div>
			</div>

			<div class="sidebar-section">
				<h4 class="sidebar-heading">Recientes</h4>
				<div class="sidebar-recent">
					{recentPosts.map(post => (
						<a href={`/blog/${post.id}/`} class="sidebar-recent-link">
							<span class="sidebar-recent-title">{post.data.title}</span>
							<span class="sidebar-recent-date">
								{post.data.pubDate.toLocaleDateString('es-EC', { day: 'numeric', month: 'short', year: 'numeric' })}
							</span>
						</a>
					))}
				</div>
			</div>

			<div class="sidebar-footer">
				<div class="sidebar-tagline">We find what's <span class="accent">underneath.</span></div>
				<div class="sidebar-social">
					<a href="https://github.com/XMag27/valdiviasec" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
						<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</aside>

	<button class="sidebar-toggle" id="sidebar-toggle" aria-label="Abrir menú">
		<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<line x1="3" y1="6" x2="21" y2="6"/>
			<line x1="3" y1="12" x2="21" y2="12"/>
			<line x1="3" y1="18" x2="21" y2="18"/>
		</svg>
	</button>

	<div class="overlay" id="overlay"></div>

	<main class="content">
		<slot />
		<Footer />
	</main>
</div>

<script>
	const toggle = document.getElementById('sidebar-toggle');
	const sidebar = document.getElementById('sidebar');
	const overlay = document.getElementById('overlay');

	function close() {
		sidebar?.classList.remove('open');
		overlay?.classList.remove('open');
		document.body.style.overflow = '';
	}

	toggle?.addEventListener('click', () => {
		sidebar?.classList.toggle('open');
		overlay?.classList.toggle('open');
		document.body.style.overflow = sidebar?.classList.contains('open') ? 'hidden' : '';
	});

	overlay?.addEventListener('click', close);

	sidebar?.querySelectorAll('a').forEach(a => {
		a.addEventListener('click', close);
	});
</script>

<style>
	.layout {
		display: flex;
		min-height: 100vh;
	}

	/* ---- Sidebar ---- */
	.sidebar {
		position: fixed;
		top: 0;
		left: 0;
		width: 260px;
		height: 100vh;
		background: var(--obsidian);
		border-right: 1px solid var(--graphite);
		display: flex;
		flex-direction: column;
		z-index: 100;
		overflow-y: auto;
		transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.sidebar-inner {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 2rem 1.5rem;
		gap: 1.5rem;
	}

	/* Brand */
	.sidebar-brand {
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--graphite);
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		transition: opacity 0.2s;
	}
	.logo:hover { opacity: 0.85; }

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.logo-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: 0.1em;
		color: var(--bone);
	}
	.logo-sub {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.2em;
		color: var(--terracota-light);
		text-transform: uppercase;
	}

	/* Nav */
	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		position: relative;
	}

	.sidebar-nav :global(a) {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 0.85rem;
		border-radius: var(--radius-sm);
		color: var(--muted);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 400;
		border: 1px solid transparent;
		transition: color 0.25s, background 0.25s, border-color 0.25s;
	}
	.sidebar-nav :global(a:hover) {
		color: var(--bone);
		background: var(--bg-2);
		border-color: var(--graphite);
	}
	.sidebar-nav :global(a.active) {
		color: var(--bone);
		background: var(--bg-2);
		border-color: var(--terracota-dark);
		font-weight: 600;
		text-decoration: none;
	}

	/* Sidebar sections */
	.sidebar-section {
		padding-top: 0.25rem;
	}

	.sidebar-heading {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 0.6rem 0;
	}

	.sidebar-tags {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.sidebar-tag {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--muted);
		padding: 0.4rem 0.6rem;
		border-radius: 6px;
		text-decoration: none;
		transition: color 0.2s, background 0.2s, border-color 0.2s;
		border: 1px solid transparent;
	}
	.sidebar-tag:hover {
		color: var(--bone);
		background: var(--bg-2);
		border-color: var(--graphite);
	}
	.sidebar-tag svg {
		flex-shrink: 0;
		color: var(--terracota-light);
	}

	.sidebar-recent {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.sidebar-recent-link {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.5rem 0.6rem;
		border-radius: 6px;
		text-decoration: none;
		transition: background 0.2s;
	}
	.sidebar-recent-link:hover {
		background: var(--bg-2);
	}
	.sidebar-recent-title {
		font-size: 0.85rem;
		color: var(--bone);
		line-height: 1.3;
	}
	.sidebar-recent-date {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}

	/* Sidebar footer */
	.sidebar-footer {
		margin-top: auto;
		padding-top: 1.25rem;
		border-top: 1px solid var(--graphite);
	}

	.sidebar-tagline {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--muted);
		margin-bottom: 0.75rem;
		line-height: 1.4;
	}
	.sidebar-tagline .accent { color: var(--terracota); }

	.sidebar-social {
		display: flex;
		gap: 0.75rem;
	}
	.sidebar-social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--graphite);
		color: var(--muted);
		transition: border-color 0.25s, color 0.25s, transform 0.25s;
	}
	.sidebar-social a:hover {
		border-color: var(--terracota);
		color: var(--terracota-light);
		transform: scale(1.1);
	}

	/* Content */
	.content {
		margin-left: 260px;
		flex: 1;
		min-height: 100vh;
		padding: 3rem 3rem 2rem;
		max-width: 100%;
	}

	/* Mobile toggle */
	.sidebar-toggle {
		display: none;
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 200;
		background: var(--bg-2);
		border: 1px solid var(--graphite);
		border-radius: var(--radius-sm);
		color: var(--bone);
		padding: 0.5rem;
		cursor: pointer;
		transition: border-color 0.2s;
	}
	.sidebar-toggle:hover { border-color: var(--terracota); }

	.overlay {
		display: none;
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		z-index: 90;
		opacity: 0;
		transition: opacity 0.3s;
	}
	.overlay.open {
		display: block;
		opacity: 1;
	}

	@media (max-width: 720px) {
		.sidebar { transform: translateX(-100%); }
		.sidebar.open { transform: translateX(0); }
		.sidebar-toggle { display: flex; align-items: center; justify-content: center; }
		.content { margin-left: 0; width: 100%; padding: 4.5rem 1.25rem 2rem; }
	}
</style>