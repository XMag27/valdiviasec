---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<img src="/isotipo.svg" alt="" width="28" height="28" />
			<span class="footer-name">VALDIVIA</span>
		</div>
		<p class="footer-tagline">We find what's <span class="accent">underneath.</span></p>
		<div class="footer-links">
			<a href="/">Inicio</a>
			<a href="/blog">Blog</a>
			<a href="/about">Nosotros</a>
		</div>
		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} ValdiviaSec. Todos los derechos reservados.</span>
			<a href="https://github.com/XMag27/valdiviasec" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
			</a>
		</div>
	</div>
</footer>
<style>
	footer {
		background: var(--obsidian);
		border-top: 1px solid var(--graphite);
		padding: 3em 1em;
		color: var(--muted);
	}
	.footer-inner {
		max-width: var(--maxw);
		margin: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1em;
	}
	.footer-brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.footer-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1em;
		letter-spacing: 0.08em;
		color: var(--bone);
	}
	.footer-tagline {
		font-family: var(--font-mono);
		font-size: 0.85em;
		margin: 0;
	}
	.accent {
		color: var(--terracota);
	}
	.footer-links {
		display: flex;
		gap: 1.5em;
	}
	.footer-links a {
		color: var(--muted);
		text-decoration: none;
		font-size: 0.9em;
		transition: color 0.2s;
	}
	.footer-links a:hover {
		color: var(--terracota-light);
	}
	.footer-bottom {
		display: flex;
		align-items: center;
		gap: 1em;
		font-size: 0.8em;
	}
	.footer-bottom a {
		color: var(--muted);
		transition: color 0.2s;
	}
	.footer-bottom a:hover {
		color: var(--terracota-light);
	}
</style>