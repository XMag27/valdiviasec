---
import SidebarLayout from '../components/SidebarLayout.astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Ciberseguridad</span>
				<h1>We find what's <span class="accent">underneath.</span></h1>
				<p class="description">
					Comunidad de ciberseguridad en Guayaquil, Ecuador. Compartimos conocimiento, organizamos encuentros y fortalecemos la seguridad digital en la región.
				</p>
			</section>

			<section class="posts">
				<h2>Últimos artículos</h2>
				<div class="post-list">
					{posts.map((post) => (
						<article class="card post-card">
							<a href={`/blog/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<p class="meta">
									<FormattedDate date={post.data.pubDate} />
									{post.data.author && <span class="author"> · {post.data.author}</span>}
								</p>
								<p class="description">{post.data.description}</p>
								{post.data.tags && (
									<div class="tags">
										{post.data.tags.map((tag: string) => (
											<span class="tag">{tag}</span>
										))}
									</div>
								)}
							</a>
						</article>
					))}
				</div>
			</section>
		</SidebarLayout>
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 3rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.75rem;
	}
	.hero h1 {
		font-size: var(--fs-hero);
		font-weight: 700;
		line-height: 1.05;
		margin: 0 0 1rem 0;
		color: var(--bone);
	}
	.hero .accent {
		color: var(--terracota);
	}
	.hero .description {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 560px;
		line-height: 1.6;
	}
	.posts {
		padding: 2rem 0;
	}
	.posts h2 {
		font-size: var(--fs-h2);
		font-weight: 700;
		margin-bottom: 1.5rem;
		color: var(--bone);
	}
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.post-card {
		padding: 1.5rem;
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.post-card h3 {
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
		color: var(--bone);
		transition: color 0.25s;
	}
	.post-card:hover h3 {
		color: var(--terracota-light);
	}
	.post-card .meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 0 0 0.5rem 0;
	}
	.post-card .description {
		margin: 0 0 0.75rem 0;
		color: var(--muted);
	}
	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
</style>