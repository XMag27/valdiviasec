---
import SidebarLayout from '../components/SidebarLayout.astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Ciberseguridad</span>
				<h1>We find what's <span class="accent">underneath.</span></h1>
				<p class="description">
					Comunidad de ciberseguridad en Guayaquil, Ecuador. Compartimos conocimiento, organizamos encuentros y fortalecemos la seguridad digital en la región.
				</p>
			</section>

			<section class="posts">
				<h2>Últimos artículos</h2>
				<div class="post-grid">
					{posts.map((post) => (
						<article class="card post-card">
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<div class="post-thumb">
										<img src={post.data.heroImage.src} alt="" loading="lazy" />
									</div>
								)}
								<div class="post-body">
									<span class="post-category">{post.data.category || 'general'}</span>
									<h3>{post.data.title}</h3>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.author && <span class="author"> · {post.data.author}</span>}
									</p>
									<p class="description">{post.data.description}</p>
									{post.data.tags && (
										<div class="tags">
											{post.data.tags.map((tag: string) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</div>
			</section>
		</SidebarLayout>
	</body>
</html>

<style>
	.hero {
		padding: 2rem 0 3rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.75rem;
	}
	.hero h1 {
		font-size: var(--fs-hero);
		font-weight: 700;
		line-height: 1.05;
		margin: 0 0 1rem 0;
		color: var(--bone);
	}
	.hero .accent { color: var(--terracota); }
	.hero .description {
		font-size: 1.1rem;
		color: var(--muted);
		max-width: 600px;
		line-height: 1.6;
	}
	.posts {
		padding: 2rem 0;
	}
	.posts h2 {
		font-size: var(--fs-h2);
		font-weight: 700;
		margin-bottom: 1.5rem;
		color: var(--bone);
	}
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.25rem;
	}
	.post-card {
		overflow: hidden;
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.post-thumb {
		border-radius: var(--radius) var(--radius) 0 0;
		overflow: hidden;
		max-height: 180px;
	}
	.post-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.post-body {
		padding: 1.25rem;
	}
	.post-category {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--terracota-light);
		display: inline-block;
		margin-bottom: 0.35rem;
	}
	.post-card h3 {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.4rem 0;
		color: var(--bone);
		transition: color 0.25s;
		line-height: 1.3;
	}
	.post-card:hover h3 { color: var(--terracota-light); }
	.post-card .meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin: 0 0 0.5rem 0;
	}
	.post-card .description {
		margin: 0 0 0.75rem 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	@media (max-width: 720px) {
		.hero { padding: 0 0 2rem; }
		.post-grid { grid-template-columns: 1fr; }
	}
</style>