---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SidebarLayout from '../../components/SidebarLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [...new Set(posts.map(p => p.data.category || 'general'))];
const categoryLabels: Record<string, string> = {
	writeup: 'Writeups',
	certificaciones: 'Certificaciones',
	general: 'General',
	'red-team': 'Red Team',
	forense: 'Forense',
	malware: 'Malware',
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description="Artículos sobre ciberseguridad por ValdiviaSec" />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Blog</span>
				<h1>Últimos <span class="accent">artículos</span></h1>
			</section>

			<div class="filter-bar" id="filter-bar">
				<button class="filter-btn active" data-filter="all">Todos</button>
				{categories.map(cat => (
					<button class="filter-btn" data-filter={cat}>{categoryLabels[cat] || cat}</button>
				))}
			</div>

			<div class="blog-layout">
				<section class="post-list" id="post-list">
					{posts.map((post) => (
						<article class="card post-card" data-category={post.data.category || 'general'}>
							<a href={`/blog/${post.id}/`}>
								<div class="post-body">
									<span class="post-category">{categoryLabels[post.data.category] || post.data.category}</span>
									<h3>{post.data.title}</h3>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.author && <span> · {post.data.author}</span>}
									</p>
									<p class="description">{post.data.description}</p>
									{post.data.tags && (
										<div class="tags">
											{post.data.tags.map((tag: string) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</section>

				<aside class="right-panel">
					<div class="panel-section">
						<h4 class="panel-heading">Tags populares</h4>
						<div class="tag-cloud">
							{[...new Set(posts.flatMap(p => p.data.tags))].slice(0, 12).map(tag => (
								<span class="tag">{tag}</span>
							))}
						</div>
					</div>
				</aside>
			</div>
		</SidebarLayout>
	</body>
</html>

<script>
	const filterBtns = document.querySelectorAll('.filter-btn');
	const postCards = document.querySelectorAll('.post-card');

	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			filterBtns.forEach(b => b.classList.remove('active'));
			btn.classList.add('active');
			const filter = btn.getAttribute('data-filter');
			postCards.forEach(card => {
				if (filter === 'all' || card.getAttribute('data-category') === filter) {
					(card as HTMLElement).style.display = '';
				} else {
					(card as HTMLElement).style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	.hero {
		padding: 0 0 1rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		font-size: var(--fs-h1);
		font-weight: 700;
		margin: 0;
		color: var(--bone);
	}
	.hero .accent { color: var(--terracota); }

	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.filter-btn {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		padding: 0.4rem 0.9rem;
		border-radius: 6px;
		border: 1px solid var(--graphite);
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition: border-color 0.25s, color 0.25s, background 0.25s;
	}
	.filter-btn:hover {
		border-color: var(--terracota-dark);
		color: var(--bone);
	}
	.filter-btn.active {
		border-color: var(--terracota);
		color: var(--bone);
		background: var(--bg-2);
	}

	.blog-layout {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 2rem;
		align-items: start;
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.post-card {
		overflow: hidden;
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.post-body {
		padding: 1.25rem;
	}
	.post-category {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--terracota-light);
		display: inline-block;
		margin-bottom: 0.35rem;
	}
	.post-card h3 {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.4rem 0;
		color: var(--bone);
		transition: color 0.25s;
		line-height: 1.3;
	}
	.post-card:hover h3 { color: var(--terracota-light); }
	.post-card .meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin: 0 0 0.5rem 0;
	}
	.post-card .description {
		margin: 0 0 0.75rem 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	/* Right panel */
	.right-panel {
		position: sticky;
		top: 2rem;
	}
	.panel-section {
		background: var(--bg-2);
		border: 1px solid var(--graphite);
		border-radius: var(--radius);
		padding: 1.25rem;
		margin-bottom: 1rem;
	}
	.panel-heading {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 0.75rem 0;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--graphite);
	}
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	@media (max-width: 960px) {
		.blog-layout {
			grid-template-columns: 1fr;
		}
		.right-panel {
			position: static;
		}
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: var(--fs-h2); }
	}
</style>