---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SidebarLayout from '../../components/SidebarLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description="Artículos sobre ciberseguridad por ValdiviaSec" />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Blog</span>
				<h1>Últimos <span class="accent">artículos</span></h1>
			</section>
			<section class="post-list">
				{posts.map((post) => (
					<article class="card post-card">
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<Image width={720} height={360} src={post.data.heroImage} alt="" />
							)}
							<h3>{post.data.title}</h3>
							<p class="meta">
								<FormattedDate date={post.data.pubDate} />
								{post.data.author && <span> · {post.data.author}</span>}
							</p>
							{post.data.tags && (
								<div class="tags">
									{post.data.tags.map((tag: string) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</a>
					</article>
				))}
			</section>
		</SidebarLayout>
	</body>
</html>

<style>
	.hero {
		padding: 0 0 1rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		font-size: var(--fs-h1);
		font-weight: 700;
		margin: 0;
		color: var(--bone);
	}
	.hero .accent {
		color: var(--terracota);
	}
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.5rem 0;
	}
	.post-card {
		padding: 1.5rem;
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.post-card img {
		margin-bottom: 0.75rem;
	}
	.post-card h3 {
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
		color: var(--bone);
		transition: color 0.25s;
	}
	.post-card:hover h3 {
		color: var(--terracota-light);
	}
	.post-card .meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		margin: 0 0 0.5rem 0;
	}
	.tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: var(--fs-h2);
		}
	}
</style>