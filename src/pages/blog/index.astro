---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SidebarLayout from '../../components/SidebarLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [...new Set(posts.map(p => p.data.category || 'general'))];
const categoryLabels: Record<string, string> = {
	writeup: 'Writeups',
	certificaciones: 'Certificaciones',
	general: 'General',
	'red-team': 'Red Team',
	forense: 'Forense',
	malware: 'Malware',
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description="Artículos sobre ciberseguridad por ValdiviaSec" />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Blog</span>
				<h1>Últimos <span class="accent">artículos</span></h1>
			</section>

			<div class="blog-layout">
				<section class="post-list">
					{posts.map((post) => (
						<article class="card post-card">
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<div class="post-thumb">
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									</div>
								)}
								<div class="post-body">
									<span class="post-category">{categoryLabels[post.data.category] || post.data.category}</span>
									<h3>{post.data.title}</h3>
									<p class="meta">
										<FormattedDate date={post.data.pubDate} />
										{post.data.author && <span> · {post.data.author}</span>}
									</p>
									{post.data.tags && (
										<div class="tags">
											{post.data.tags.map((tag: string) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</section>

				<aside class="right-panel">
					<div class="panel-section">
						<h4 class="panel-heading">Categorías</h4>
						<div class="category-list">
							{categories.map(cat => (
								<span class="category-pill">{categoryLabels[cat] || cat}</span>
							))}
						</div>
					</div>

					<div class="panel-section">
						<h4 class="panel-heading">Tags populares</h4>
						<div class="tag-cloud">
							{[...new Set(posts.flatMap(p => p.data.tags))].slice(0, 12).map(tag => (
								<span class="tag">{tag}</span>
							))}
						</div>
					</div>
				</aside>
			</div>
		</SidebarLayout>
	</body>
</html>

<style>
	.hero {
		padding: 0 0 1rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		font-size: var(--fs-h1);
		font-weight: 700;
		margin: 0;
		color: var(--bone);
	}
	.hero .accent { color: var(--terracota); }

	.blog-layout {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 2rem;
		align-items: start;
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.post-card {
		overflow: hidden;
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.post-thumb {
		border-radius: var(--radius) var(--radius) 0 0;
		overflow: hidden;
		max-height: 200px;
	}
	.post-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.post-body {
		padding: 1.25rem;
	}
	.post-category {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--terracota-light);
		display: inline-block;
		margin-bottom: 0.35rem;
	}
	.post-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		margin: 0 0 0.4rem 0;
		color: var(--bone);
		transition: color 0.25s;
		line-height: 1.3;
	}
	.post-card:hover h3 { color: var(--terracota-light); }
	.post-card .meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin: 0 0 0.5rem 0;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	/* Right panel */
	.right-panel {
		position: sticky;
		top: 2rem;
	}
	.panel-section {
		background: var(--bg-2);
		border: 1px solid var(--graphite);
		border-radius: var(--radius);
		padding: 1.25rem;
		margin-bottom: 1rem;
	}
	.panel-heading {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 0.75rem 0;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--graphite);
	}
	.category-list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.category-pill {
		display: inline-block;
		font-size: 0.85rem;
		color: var(--bone);
		padding: 0.35rem 0.7rem;
		border-radius: 6px;
		background: var(--obsidian);
		border: 1px solid var(--graphite);
		transition: border-color 0.2s, color 0.2s;
	}
	.category-pill:hover {
		border-color: var(--terracota-dark);
		color: var(--terracota-light);
	}
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	@media (max-width: 960px) {
		.blog-layout {
			grid-template-columns: 1fr;
		}
		.right-panel {
			position: static;
		}
	}
	@media (max-width: 720px) {
		.hero h1 { font-size: var(--fs-h2); }
	}
</style>