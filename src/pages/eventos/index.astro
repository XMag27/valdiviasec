---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SidebarLayout from '../../components/SidebarLayout.astro';
import { SITE_TITLE } from '../../consts';

const events = (await getCollection('eventos')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const eventTypeLabels: Record<string, string> = {
	organizado: 'Organizado',
	asistido: 'Asistido',
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Eventos - ${SITE_TITLE}`} description="Eventos organizados y asistidos por ValdiviaSec" />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Eventos</span>
				<h1>Encuentros y <span class="accent">eventos</span></h1>
				<p class="description">Actividades organizadas por la comunidad y eventos donde participamos.</p>
			</section>

			{events.length === 0 && (
				<div class="empty-state">
					<p>Aún no hay eventos publicados. Pronto compartiremos información sobre próximos encuentros.</p>
				</div>
			)}

			{events.length > 0 && (
				<div class="events-grid">
					{events.map((event) => (
						<article class="card event-card">
							<a href={`/eventos/${event.id}/`}>
								<div class="event-body">
									<span class="event-type">{eventTypeLabels[event.data.eventType] || event.data.eventType}</span>
									<h3>{event.data.title}</h3>
									<p class="meta">
										<FormattedDate date={event.data.pubDate} />
										{event.data.author && <span> · {event.data.author}</span>}
									</p>
									<p class="description">{event.data.description}</p>
									{event.data.eventDate && (
										<div class="event-detail">
											<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
											<FormattedDate date={event.data.eventDate} />
										</div>
									)}
									{event.data.location && (
										<div class="event-detail">
											<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
											{event.data.location}
										</div>
									)}
									{event.data.tags && (
										<div class="tags">
											{event.data.tags.map((tag: string) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</div>
			)}
		</SidebarLayout>
	</body>
</html>

<style>
	.hero {
		padding: 0 0 1rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		font-size: var(--fs-h1);
		font-weight: 700;
		margin: 0;
		color: var(--bone);
	}
	.hero .accent { color: var(--terracota); }
	.hero .description {
		color: var(--muted);
		font-size: 1rem;
		max-width: 560px;
		margin-top: 0.5rem;
		line-height: 1.5;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 0;
		color: var(--muted);
		font-size: 1rem;
	}

	.events-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.event-card {
		overflow: hidden;
	}
	.event-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.event-body {
		padding: 1.25rem;
	}
	.event-type {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--terracota-light);
		display: inline-block;
		margin-bottom: 0.35rem;
		border: 1px solid var(--terracota-dark);
		border-radius: 4px;
		padding: 0.1rem 0.5rem;
	}
	.event-card h3 {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.4rem 0;
		color: var(--bone);
		transition: color 0.25s;
		line-height: 1.3;
	}
	.event-card:hover h3 { color: var(--terracota-light); }
	.event-card .meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin: 0 0 0.5rem 0;
	}
	.event-card .description {
		margin: 0 0 0.75rem 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.event-detail {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin-bottom: 0.35rem;
	}
	.event-detail svg {
		color: var(--terracota-light);
		flex-shrink: 0;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}

	@media (max-width: 720px) {
		.hero h1 { font-size: var(--fs-h2); }
	}
</style>