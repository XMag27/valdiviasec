---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import SidebarLayout from '../../components/SidebarLayout.astro';
import { SITE_TITLE } from '../../consts';

const noticias = (await getCollection('noticias')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Noticias - ${SITE_TITLE}`} description="Noticias de ciberseguridad relevantes compartidas por ValdiviaSec" />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Noticias</span>
				<h1>Noticias <span class="accent">relevantes</span></h1>
				<p class="description">Noticias de ciberseguridad que consideramos importantes compartir con la comunidad.</p>
			</section>

			{noticias.length === 0 && (
				<div class="empty-state">
					<p>Aún no hay noticias publicadas. Compartiremos noticias interesantes pronto.</p>
				</div>
			)}

			{noticias.length > 0 && (
				<div class="noticias-grid">
					{noticias.map((noticia) => (
						<article class="card noticia-card">
							<a href={`/noticias/${noticia.id}/`}>
								<div class="noticia-body">
									<span class="noticia-type">Noticia</span>
									<h3>{noticia.data.title}</h3>
									<p class="meta">
										<FormattedDate date={noticia.data.pubDate} />
										{noticia.data.author && <span> · {noticia.data.author}</span>}
									</p>
									<p class="description">{noticia.data.description}</p>
									{noticia.data.source && (
										<div class="source">
											Fuente: {noticia.data.source}
										</div>
									)}
									{noticia.data.tags && (
										<div class="tags">
											{noticia.data.tags.map((tag: string) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</div>
							</a>
						</article>
					))}
				</div>
			)}
		</SidebarLayout>
	</body>
</html>

<style>
	.hero {
		padding: 0 0 1rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		font-size: var(--fs-h1);
		font-weight: 700;
		margin: 0;
		color: var(--bone);
	}
	.hero .accent { color: var(--terracota); }
	.hero .description {
		color: var(--muted);
		font-size: 1rem;
		max-width: 560px;
		margin-top: 0.5rem;
		line-height: 1.5;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 0;
		color: var(--muted);
		font-size: 1rem;
	}

	.noticias-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.noticia-card {
		overflow: hidden;
	}
	.noticia-card a {
		text-decoration: none;
		color: inherit;
		display: block;
	}
	.noticia-body {
		padding: 1.25rem;
	}
	.noticia-type {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--terracota-light);
		display: inline-block;
		margin-bottom: 0.35rem;
		border: 1px solid var(--terracota-dark);
		border-radius: 4px;
		padding: 0.1rem 0.5rem;
	}
	.noticia-card h3 {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 0.4rem 0;
		color: var(--bone);
		transition: color 0.25s;
		line-height: 1.3;
	}
	.noticia-card:hover h3 { color: var(--terracota-light); }
	.noticia-card .meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin: 0 0 0.5rem 0;
	}
	.noticia-card .description {
		margin: 0 0 0.75rem 0;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.5;
	}
	.source {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		margin-bottom: 0.5rem;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}

	@media (max-width: 720px) {
		.hero h1 { font-size: var(--fs-h2); }
	}
</style>