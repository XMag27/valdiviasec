---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const team = [
  {
    name: 'Paolo Lara',
    role: 'Fundador',
    bio: 'Apasionado por la ciberseguridad y la comunidad tech en Guayaquil.',
    github: 'https://github.com/larapaolos',
    linkedin: 'https://www.linkedin.com/in/larapaolos/',
  },
  {
    name: 'Xavier Magallanes',
    role: 'Co-fundador',
    bio: 'Pentester, OSCP, red teamer. Comprometido con la seguridad ofensiva y la formación.',
    github: 'https://github.com/XMag27',
  },
  {
    name: 'David Garcia',
    role: 'Miembro',
    bio: 'Entusiasta de la seguridad informática y la investigación en hacking ético.',
    github: 'https://github.com/',
  },
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Nosotros - ValdiviaSec" description="Comunidad de ciberseguridad en Guayaquil, Ecuador" />
	</head>
	<body>
		<Header />
		<main>
			<h1>Nosotros</h1>
			<p>
				<strong>ValdiviaSec</strong> es una comunidad de ciberseguridad basada en Guayaquil, Ecuador.
				Nuestro objetivo es crear un espacio colaborativo donde profesionales, estudiantes y
				entusiastas de la seguridad informática puedan compartir conocimiento y crecer juntos.
			</p>

			<h2>Nuestra misión</h2>
			<ul>
				<li>Promover la cultura de seguridad informática en la región</li>
				<li>Compartir conocimiento técnico a través de artículos y encuentros</li>
				<li>Crear un espacio inclusivo para aprender y practicar</li>
				<li>Conectar profesionales y empresas del sector</li>
			</ul>

			<h2>Equipo</h2>
			<div class="team-grid">
				{team.map((member) => (
					<div class="team-card">
						<div class="team-avatar">
							<svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
								<circle cx="12" cy="8" r="4" />
								<path d="M4 20c0-4 4-7 8-7s8 3 8 7" />
							</svg>
						</div>
						<h3>{member.name}</h3>
						<span class="team-role">{member.role}</span>
						<p>{member.bio}</p>
						<div class="team-links">
							<a href={member.github} target="_blank" rel="noopener noreferrer" class="team-link">
								<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
									<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
								</svg>
							</a>
							{member.linkedin && (
								<a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="team-link">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
									</svg>
								</a>
							)}
						</div>
					</div>
				))}
			</div>

			<h2>¿Cómo participar?</h2>
			<p>
				Si te interesa colaborar con un artículo o sumarte al equipo, contactanos.
			</p>

			<h2>Contacto</h2>
			<p>
				¿Tienes preguntas o quieres colaborar? Escríbenos a
				<a href="mailto:contacto@valdiviasec.com">contacto@valdiviasec.com</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5em;
		margin: 1.5em 0;
	}
	.team-card {
		background: white;
		border-radius: 12px;
		padding: 2em 1.5em;
		text-align: center;
		box-shadow: 0 2px 8px rgba(0,0,0,0.08);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.team-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 4px 16px rgba(0,0,0,0.12);
	}
	.team-avatar {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		background: rgb(var(--gray-light));
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1em;
		color: var(--accent);
	}
	.team-card h3 {
		margin: 0 0 0.25em;
		font-size: 1.25em;
	}
	.team-role {
		display: inline-block;
		font-size: 0.85em;
		color: var(--accent);
		font-weight: 600;
		margin-bottom: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.team-card p {
		font-size: 0.95em;
		color: rgb(var(--gray));
		margin-bottom: 1em;
		line-height: 1.5;
	}
	.team-links {
		display: flex;
		justify-content: center;
		gap: 0.6em;
	}
	.team-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: rgb(var(--gray-light));
		transition: background 0.2s, color 0.2s;
	}
	.team-link:hover {
		background: var(--accent);
		color: white;
	}
</style>