---
import BaseHead from '../components/BaseHead.astro';
import SidebarLayout from '../components/SidebarLayout.astro';

const team = [
	{
		name: 'Paolo Lara',
		role: 'Fundador',
		github: 'https://github.com/larapaolos',
		linkedin: 'https://www.linkedin.com/in/larapaolos/',
	},
	{
		name: 'Xavier Magallanes',
		role: 'Co-fundador',
		github: 'https://github.com/XMag27',
	},
	{
		name: 'David Garcia',
		role: 'Miembro',
		github: 'https://github.com/',
	},
];

const certs = [
	{ src: '/badges/oscp.png', alt: 'OSCP+', org: 'OffSec' },
	{ src: '/badges/oswp.png', alt: 'OSWP', org: 'OffSec' },
	{ src: '/badges/ewpt.png', alt: 'eWPT', org: 'INE' },
	{ src: '/badges/ejptv2.png', alt: 'eJPTv2', org: 'INE' },
	{ src: '/badges/ceh-master.jpeg', alt: 'CEH Master', org: 'EC-Council' },
	{ src: '/badges/crta.png', alt: 'eMAPT', org: 'INE' },
	{ src: '/badges/crtid.png', alt: 'eWPTX', org: 'INE' },
	{ src: '/badges/cartp.png', alt: 'CARTP', org: 'Altered Security' },
	{ src: '/badges/gosi.png', alt: 'GOSI', org: 'SANS' },
	{ src: '/badges/cnpen.png', alt: 'CRTO', org: 'Zero Point Security' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title="Nosotros - ValdiviaSec" description="Equipo y misión de ValdiviaSec, comunidad de ciberseguridad en Guayaquil, Ecuador" />
	</head>
	<body>
		<SidebarLayout>
			<section class="hero">
				<span class="kicker">Nosotros</span>
				<h1>La comunidad detrás de <span class="accent">ValdiviaSec</span></h1>
				<p>
					Un espacio colaborativo donde profesionales, estudiantes y entusiastas de la seguridad informática pueden compartir conocimiento y crecer juntos.
				</p>
			</section>

			<section class="mission">
				<h2>Nuestra misión</h2>
				<div class="mission-grid">
					<div class="mission-item">
						<span class="mission-num">01</span>
						<p>Promover la cultura de seguridad informática en la región</p>
					</div>
					<div class="mission-item">
						<span class="mission-num">02</span>
						<p>Compartir conocimiento técnico a través de artículos y encuentros</p>
					</div>
					<div class="mission-item">
						<span class="mission-num">03</span>
						<p>Crear un espacio inclusivo para aprender y practicar</p>
					</div>
					<div class="mission-item">
						<span class="mission-num">04</span>
						<p>Conectar profesionales y empresas del sector</p>
					</div>
				</div>
			</section>

			<section class="certs">
				<h2>Certificaciones</h2>
				<p class="section-sub">Las credenciales que respaldan a nuestra comunidad.</p>
				<div class="certs-grid">
					{certs.map((cert) => (
						<div class="cert-card">
							<img src={cert.src} alt={cert.alt} class:list={['cert-img', { 'cert-img--lg': cert.org === 'INE' }]} loading="lazy" />
							<div class="cert-name">{cert.alt}</div>
							<div class="cert-org">{cert.org}</div>
						</div>
					))}
				</div>
			</section>

			<section class="team">
				<h2>Equipo</h2>
				<div class="team-grid">
					{team.map((member) => (
						<div class="card team-card">
							<div class="team-avatar">
								<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5">
									<circle cx="12" cy="8" r="4" />
									<path d="M4 20c0-4 4-7 8-7s8 3 8 7" />
								</svg>
							</div>
							<h3>{member.name}</h3>
							<span class="team-role">{member.role}</span>
							<div class="team-links">
								<a href={member.github} target="_blank" rel="noopener noreferrer" class="team-link" aria-label="GitHub">
									<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
								</a>
								{member.linkedin && (
									<a href={member.linkedin} target="_blank" rel="noopener noreferrer" class="team-link" aria-label="LinkedIn">
										<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
									</a>
								)}
							</div>
						</div>
					))}
				</div>
			</section>

			<section class="contact">
				<h2>¿Cómo participar?</h2>
				<p>
					Si te interesa colaborar con un artículo o sumarte al equipo, contactanos en
					<a href="mailto:contacto@valdiviasec.com">contacto@valdiviasec.com</a>
				</p>
			</section>
		</SidebarLayout>
	</body>
</html>

<style>
	/* Hero */
	.hero {
		text-align: center;
		padding: 0 0 2.5rem;
	}
	.hero .kicker {
		display: block;
		margin-bottom: 0.5rem;
	}
	.hero h1 {
		font-size: var(--fs-h1);
		font-weight: 700;
		margin: 0 0 0.75rem 0;
		color: var(--bone);
	}
	.hero .accent {
		color: var(--terracota);
	}
	.hero p {
		color: var(--muted);
		max-width: 540px;
		margin: 0 auto;
		line-height: 1.7;
	}

	/* Mission */
	.mission {
		padding: 2.5rem 0;
		border-top: 1px solid var(--graphite);
	}
	.mission h2 {
		font-size: var(--fs-h2);
		margin-bottom: 1.5rem;
		text-align: center;
	}
	.mission-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		max-width: 600px;
		margin: 0 auto;
	}
	.mission-item {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 1.25rem;
		background: var(--bg-2);
		border: 1px solid var(--graphite);
		border-radius: var(--radius);
		transition: border-color 0.3s ease;
	}
	.mission-item:hover {
		border-color: var(--terracota-dark);
	}
	.mission-num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--terracota);
		flex-shrink: 0;
		padding-top: 0.15rem;
	}
	.mission-item p {
		margin: 0;
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	/* Certificaciones */
	.certs {
		padding: 2.5rem 0;
		border-top: 1px solid var(--graphite);
	}
	.certs h2 {
		font-size: var(--fs-h2);
		margin-bottom: 0.25rem;
		text-align: center;
	}
	.section-sub {
		color: var(--muted);
		font-size: 0.88rem;
		margin-bottom: 1.75rem;
		text-align: center;
	}
	.certs-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem;
	}
	.cert-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 1.5rem 1.25rem 1.25rem;
		background: var(--bg-2);
		border: 1px solid var(--graphite);
		border-radius: var(--radius);
		transition: border-color 0.3s ease, transform 0.2s ease;
		width: 140px;
	}
	.cert-card:hover {
		border-color: var(--terracota-dark);
		transform: translateY(-3px);
	}
	.cert-img {
		height: 80px;
		width: auto;
		border-radius: 8px;
	}
	.cert-img--lg {
		height: 100px;
	}
	.cert-name {
		font-weight: 700;
		color: var(--bone);
		font-size: 0.85rem;
		letter-spacing: 0.02em;
		text-align: center;
	}
	.cert-org {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		color: var(--terracota-light);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		text-align: center;
		margin-top: -0.3rem;
	}

	/* Team */
	.team {
		padding: 2.5rem 0;
		border-top: 1px solid var(--graphite);
	}
	.team h2 {
		font-size: var(--fs-h2);
		margin-bottom: 1.5rem;
		text-align: center;
	}
	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
		max-width: 700px;
		margin: 0 auto;
	}
	.team-card {
		padding: 2em 1.5em;
		text-align: center;
	}
	.team-avatar {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--obsidian);
		border: 2px solid var(--terracota-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1em;
		color: var(--terracota-light);
	}
	.team-card h3 {
		margin: 0 0 0.2em;
		font-size: 1.1em;
		color: var(--bone);
	}
	.team-role {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.7em;
		color: var(--terracota-light);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 0.75em;
	}
	.team-links {
		display: flex;
		justify-content: center;
		gap: 0.5em;
	}
	.team-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		text-decoration: none;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--graphite);
		transition: border-color 0.25s, color 0.25s, transform 0.25s;
	}
	.team-link:hover {
		border-color: var(--terracota);
		color: var(--terracota-light);
		transform: scale(1.1);
	}

	/* Contact */
	.contact {
		padding: 2.5rem 0;
		border-top: 1px solid var(--graphite);
		text-align: center;
	}
	.contact h2 {
		font-size: var(--fs-h2);
		margin-bottom: 0.75rem;
	}
	.contact p {
		color: var(--muted);
	}
	.contact a {
		color: var(--terracota-light);
	}
</style>