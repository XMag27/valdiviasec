---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SidebarLayout from '../components/SidebarLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, author } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<SidebarLayout>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="meta">
							<FormattedDate date={pubDate} />
							{author && <span> · {author}</span>}
						</div>
						{
							updatedDate && (
								<div class="last-updated-on">
									Actualizado el <FormattedDate date={updatedDate} />
								</div>
							)
						}
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</SidebarLayout>
	</body>
</html>

<style>
	.hero-image {
		width: 100%;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: var(--radius);
		border: 1px solid var(--graphite);
	}
	.prose {
		max-width: 720px;
		padding: 1em 0;
		color: var(--bone);
	}
	.prose :global(h2),
	.prose :global(h3) {
		color: var(--bone);
	}
	.prose :global(a) {
		color: var(--terracota-light);
	}
	.prose :global(a:hover) {
		color: var(--terracota);
	}
	.prose :global(code) {
		background: var(--bg-2);
		border: 1px solid var(--graphite);
	}
	.prose :global(pre) {
		background: var(--bg-2);
		border: 1px solid var(--graphite);
	}
	.prose :global(blockquote) {
		border-left-color: var(--terracota);
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.5em 0;
		color: var(--bone);
	}
	.meta {
		display: flex;
		gap: 0.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.last-updated-on {
		font-style: italic;
		color: var(--muted);
		font-size: 0.85rem;
	}
	hr {
		border-color: var(--graphite);
	}
</style>