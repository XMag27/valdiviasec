---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SidebarLayout from '../components/SidebarLayout.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author, category, tags } = Astro.props;

const categoryLabels: Record<string, string> = {
	writeup: 'Writeups',
	certificaciones: 'Certificaciones',
	general: 'General',
	'red-team': 'Red Team',
	forense: 'Forense',
	malware: 'Malware',
};
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<SidebarLayout>
			<article class="blog-post-layout">
				<div class="post-main">
					<div class="prose">
						<div class="title">
							<span class="post-category">{categoryLabels[category] || category}</span>
							<h1>{title}</h1>
							<div class="meta">
								<FormattedDate date={pubDate} />
								{author && <span> · {author}</span>}
							</div>
							{
								updatedDate && (
									<div class="last-updated-on">
										Actualizado el <FormattedDate date={updatedDate} />
									</div>
								)
							}
							<hr />
						</div>
						<slot />
					</div>
				</div>

				<aside class="post-sidebar">
					{tags && tags.length > 0 && (
						<div class="panel-section">
							<h4 class="panel-heading">Tags</h4>
							<div class="tag-cloud">
								{tags.map((tag: string) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						</div>
					)}
					<div class="panel-section">
						<h4 class="panel-heading">Detalles</h4>
						<div class="detail-row">
							<span class="detail-label">Categoría</span>
							<span class="detail-value">{categoryLabels[category] || category}</span>
						</div>
						<div class="detail-row">
							<span class="detail-label">Publicado</span>
							<span class="detail-value"><FormattedDate date={pubDate} /></span>
						</div>
						{author && (
							<div class="detail-row">
								<span class="detail-label">Autor</span>
								<span class="detail-value">{author}</span>
							</div>
						)}
					</div>
				</aside>
			</article>
		</SidebarLayout>
	</body>
</html>

<style>
	.blog-post-layout {
		display: grid;
		grid-template-columns: 1fr 240px;
		gap: 2.5rem;
		align-items: start;
	}

	.prose {
		max-width: 720px;
		padding: 1em 0;
		color: var(--bone);
	}
	.prose :global(h2),
	.prose :global(h3) {
		color: var(--bone);
	}
	.prose :global(a) {
		color: var(--terracota-light);
	}
	.prose :global(a:hover) {
		color: var(--terracota);
	}
	.prose :global(code) {
		background: var(--bg-2);
		border: 1px solid var(--graphite);
	}
	.prose :global(pre) {
		background: var(--bg-2);
		border: 1px solid var(--graphite);
	}
	.prose :global(blockquote) {
		border-left-color: var(--terracota);
	}
	.title {
		margin-bottom: 1em;
		padding: 0 0 1em;
	}
	.post-category {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--terracota-light);
		display: inline-block;
		margin-bottom: 0.5rem;
	}
	.title h1 {
		margin: 0 0 0.5rem 0;
		color: var(--bone);
		line-height: 1.15;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		flex-wrap: wrap;
	}
	.last-updated-on {
		font-style: italic;
		color: var(--muted);
		font-size: 0.85rem;
		margin-top: 0.25rem;
	}
	hr {
		border-color: var(--graphite);
		margin-top: 1rem;
	}

	/* Post sidebar */
	.post-sidebar {
		position: sticky;
		top: 2rem;
	}
	.panel-section {
		background: var(--bg-2);
		border: 1px solid var(--graphite);
		border-radius: var(--radius);
		padding: 1.25rem;
		margin-bottom: 1rem;
	}
	.panel-heading {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 0.75rem 0;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--graphite);
	}
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.detail-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 0.35rem 0;
		border-bottom: 1px solid var(--graphite);
		font-size: 0.85rem;
	}
	.detail-row:last-child {
		border-bottom: none;
	}
	.detail-label {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	.detail-value {
		color: var(--bone);
		font-size: 0.85rem;
		text-align: right;
	}

	@media (max-width: 960px) {
		.blog-post-layout {
			grid-template-columns: 1fr;
		}
		.post-sidebar {
			position: static;
		}
	}
</style>